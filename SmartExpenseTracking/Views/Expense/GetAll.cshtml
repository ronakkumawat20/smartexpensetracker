@model List<SET.Models.ExpenseViewModel>

@{
    ViewData["Title"] = "Expenses List";
    var totalAmount = Model?.Sum(x => x.Amount) ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0">Expense Tracker</h2>
        <p class="text-muted mb-0">Overview of all recorded expenses</p>
    </div>
    <a asp-action="Add" class="btn btn-success">
        + Add New Expense
    </a>
</div>

<div class="row mb-4">
    <div class="col-md-6 col-lg-4 mb-3 mb-lg-0">
        <div class="card border-0 shadow-sm bg-primary text-white">
            <div class="card-body p-3">
                <div class="text-white-50 small font-weight-bold uppercase">Total Expenses</div>
                <div class="h3 mb-0 font-weight-bold">@totalAmount.ToString("C")</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card border-0 shadow-sm bg-info text-white">
            <div class="card-body p-3">
                <div class="text-white-50 small font-weight-bold uppercase">Total Transactions</div>
                <div class="h3 mb-0 font-weight-bold">@(Model?.Count ?? 0)</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (Model == null || !Model.Any())
        {
            <div class="p-5 text-center text-muted">
                <h5>No expenses found</h5>
                <p>Click "Add New Expense" to create your first expense record.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Amount</th>
                            <th>Description</th>
                            <th style="width: 160px;" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var expense in Model)
                        {
                            <tr>
                                <td class="font-weight-bold">@expense.Title</td>
                                <td>
                                    <span class="badge bg-secondary">@expense.Category</span>
                                </td>
                                <td class="text-success font-weight-bold">@expense.Amount.ToString("C")</td>
                                <td class="text-muted">@(string.IsNullOrEmpty(expense.Description) ? "-" : expense.Description)</td>
                                <td class="text-end">
                                    <a asp-action="Update" asp-route-uniqueId="@expense.UniqueId" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                                    <a asp-action="Delete"
                                       asp-route-uniqueId="@expense.UniqueId"
                                       onclick="return confirm('Are you sure you want to delete this expense?');"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
