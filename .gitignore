## Ignore Visual Studio & .NET temporary files, build results, and user settings

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
[Bb]in/
[Ob]j/
[Lg]og/
[Lg]ogs/
bin/
obj/

# Visual Studio & VS Code files
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.rsuser

# Operating System Files
.DS_Store
Thumbs.db

# User specific / local configs (keep standard appsettings.Development.json tracked if clean)
appsettings.Local.json
*.secrets.json

# NuGet / Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
project.lock.json
project.fragment.lock.json
artifacts/
